#include <windows.h>

#define IDI_APP_ICON       101
#define IDR_LOGO_PNG       102
#define IDR_ICON_PNG       103
#define IDR_PLUGIN_DLL     104
#define IDR_APP_EXE        105

IDI_APP_ICON   ICON    "../assets/lala_icon.ico"
IDR_LOGO_PNG   RCDATA  "../assets/png/lala_logo_horizontal_transparent_1200x400.png"
IDR_ICON_PNG   RCDATA  "../assets/png/lala_icon_app_64.png"

// Embed the statically-linked plugin DLL and standalone exe.
// These are built with /MT so end users don't need MSVC Redistributable.
// The plugin supports both Qt5 (OBS 25-27) and Qt6 (OBS 28+).
IDR_PLUGIN_DLL RCDATA  "../build/yt-chat-overlay.dll"
IDR_APP_EXE    RCDATA  "../build/YouTubeChatOverlay.exe"
